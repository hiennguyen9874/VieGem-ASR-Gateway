# Include inside nginx's http {}. Replace server_name and certificate paths.
# Example only: validate with nginx -t, then run the benchmark THROUGH this proxy.
map $http_upgrade $quan_connection {
    default upgrade;
    ''      close;
}

upstream quan_gateway {
    server 127.0.0.1:18000;
}

server {
    listen 443 ssl;
    server_name transcribe.example.com;
    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Do not write URL/query/Authorization to access logs. Do not enable body/debug logs.
    access_log off;
    error_log /var/log/nginx/quan-error.log warn;
    client_max_body_size 25m;  # whole multipart body, same as QUAN_MAX_UPLOAD_BYTES
    client_body_timeout 60s;  # inactivity limit, not a total upload deadline

    location = /metrics {
        allow 127.0.0.1;
        deny all;
        proxy_pass http://quan_gateway;
        # Authorization is also required by the gateway.
    }

    location / {
        proxy_pass http://quan_gateway;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $quan_connection;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_buffering off;          # SSE must not wait for proxy buffers
        proxy_request_buffering off;  # gateway owns bounded upload spool
        proxy_cache off;
        proxy_next_upstream off;      # never replay POSTs or WS commits
        proxy_connect_timeout 5s;
        proxy_read_timeout 610s;       # > QUAN_REQUEST_TIMEOUT_SECONDS=600 (idle gap, not total)
        proxy_send_timeout 610s;
    }
}
